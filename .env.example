# Copia este archivo como .env y completa los valores. El .env NO se sube a Git.
MYSQL_ROOT_PASSWORD=cambia-esto
DB_USER=nutribot
DB_PASSWORD=cambia-esto
NUTRIBOT_JWT_SECRET=una-cadena-aleatoria-de-al-menos-32-caracteres
NUTRIBOT_JWT_HORAS=8
NUTRIBOT_ADMIN_USER=admin
NUTRIBOT_ADMIN_PASSWORD=cambia-esto
NUTRIBOT_ASESOR_USER=asesor
NUTRIBOT_ASESOR_PASSWORD=cambia-esto
NUTRIBOT_CORS_ORIGINS=http://localhost:4200

# DEF-14: tiempo que Ollama mantiene Mistral cargado en la GPU (una jornada)
NUTRIBOT_OLLAMA_KEEP_ALIVE=8h

# DEF-15: horario de atencion de los asesores (hora de Peru; domingo cerrado). Opcional.
# NUTRIBOT_HORARIO_SEMANA=08:00-18:00
# NUTRIBOT_HORARIO_SABADO=08:00-13:00
